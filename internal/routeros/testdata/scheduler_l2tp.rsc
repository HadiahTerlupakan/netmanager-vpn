/system scheduler remove [find name=netmanager-vpn-switch]
/system script remove [find name=netmanager-vpn-switch]
/system script add name=netmanager-vpn-switch policy=read,write,policy,test comment="netmanager-vpn" source=":global nmVpnFail\n:global nmVpnFailCount\n:global nmVpnSwitchAt\n:if ([:typeof \$nmVpnFail] != \"array\") do={ :set nmVpnFail [:toarray \"\"] }\n:if ([:typeof \$nmVpnFailCount] != \"num\") do={ :set nmVpnFailCount 0 }\n:local servers {\"hub-a.example.net|500|c2VjcmV0LW9uZS1zZWNyZXQtb25lLXNlY3JldC1vbmU\";\"203.0.113.20|500|c2VjcmV0LXR3by1zZWNyZXQtdHdvLXNlY3JldC10d28\"}\n:local now [/system resource get uptime]\n:local settled true\n:if ([:typeof \$nmVpnSwitchAt] = \"time\") do={ :if ((\$now - \$nmVpnSwitchAt) < 00:01:00) do={ :set settled false } }\n:if (\$settled) do={\n  :local got 0\n  :do { :set got [/ping 10.99.0.1 src-address=10.100.0.10 count=5 interval=1s] } on-error={}\n  :if (\$got >= 4) do={ :set nmVpnFailCount 0 } else={ :set nmVpnFailCount (\$nmVpnFailCount + 1) }\n  :if (\$nmVpnFailCount >= 2) do={\n    :set nmVpnFailCount 0\n    :local id ([/interface l2tp-client find name=netmanager-vpn]->0)\n    :local cur ([:tostr [/interface l2tp-client get \$id connect-to]] . \"|500|\" . [/interface l2tp-client get \$id ipsec-secret])\n    :local curEp [:pick \$cur 0 [:find \$cur \"|\" [:find \$cur \"|\"]]]\n    :set (\$nmVpnFail->\$curEp) \$now\n    :local n [:len \$servers]\n    :local idx [:find \$servers \$cur]\n    :if ([:typeof \$idx] != \"num\") do={ :set idx -1 }\n    :local next \"\"\n    :for k from=1 to=\$n do={\n      :local s [:pick \$servers ((\$idx + \$k) % \$n)]\n      :local ep [:pick \$s 0 [:find \$s \"|\" [:find \$s \"|\"]]]\n      :local t (\$nmVpnFail->\$ep)\n      :local fresh false\n      :if ([:typeof \$t] = \"time\") do={ :set fresh ((\$now - \$t) < 00:05:00) }\n      :if ((\$next = \"\") && (\$fresh = false)) do={ :set next \$s }\n    }\n    :if (\$next = \"\") do={ :set next [:pick \$servers 0] }\n    :if (\$next != \$cur) do={\n      :local p [:find \$next \"|\"]\n      :local host [:pick \$next 0 \$p]\n      :local rest [:pick \$next (\$p + 1) [:len \$next]]\n      :set p [:find \$rest \"|\"]\n      /interface l2tp-client set \$id connect-to=\$host ipsec-secret=[:pick \$rest (\$p + 1) [:len \$rest]]\n      :set nmVpnSwitchAt \$now\n      :log warning (\"netmanager-vpn: pindah ke \" . \$host)\n    }\n  }\n}\n"
/system scheduler add name=netmanager-vpn-switch interval=20s policy=read,write,policy,test comment="netmanager-vpn" on-event="/system script run netmanager-vpn-switch"
