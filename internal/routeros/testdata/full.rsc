:if ([:len [/interface bridge find name=netmanager-lo]] = 0) do={ /interface bridge add name=netmanager-lo comment="netmanager-vpn" }
/interface bridge set [find name=netmanager-lo] comment="netmanager-vpn"
:if ([:len [/ip address find interface=netmanager-lo comment="netmanager-vpn"]] = 0) do={ /ip address add interface=netmanager-lo address=10.100.0.10/32 comment="netmanager-vpn" }
/ip address set [find interface=netmanager-lo comment="netmanager-vpn"] address=10.100.0.10/32 comment="netmanager-vpn"
:if ([:len [/interface wireguard find name=netmanager-vpn]] = 0) do={ /interface wireguard add name=netmanager-vpn mtu=1420 private-key="yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk=" comment="netmanager-vpn: Kantor \"Pusat\" \$1" }
/interface wireguard set [find name=netmanager-vpn] mtu=1420 private-key="yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk=" comment="netmanager-vpn: Kantor \"Pusat\" \$1"
:if ([:len [/interface wireguard peers find interface=netmanager-vpn]] = 0) do={ /interface wireguard peers add interface=netmanager-vpn public-key="xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg=" endpoint-address="hub-a.example.net" endpoint-port=51821 allowed-address=10.99.0.0/24,10.99.128.0/24 persistent-keepalive=25s comment="netmanager-vpn" }
/interface wireguard peers set [find interface=netmanager-vpn] allowed-address=10.99.0.0/24,10.99.128.0/24 persistent-keepalive=25s comment="netmanager-vpn"
:if ([:len [/routing table find name=netmanager-vpn]] = 0) do={ /routing table add name=netmanager-vpn fib comment="netmanager-vpn" }
/routing table set [find name=netmanager-vpn] comment="netmanager-vpn"
:if ([:len [/routing rule find comment="netmanager-vpn" dst-address=10.99.0.0/24]] = 0) do={ /routing rule add dst-address=10.99.0.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" }
/routing rule set [find comment="netmanager-vpn" dst-address=10.99.0.0/24] action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn"
:if ([:len [/routing rule find comment="netmanager-vpn" dst-address=10.99.128.0/24]] = 0) do={ /routing rule add dst-address=10.99.128.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" }
/routing rule set [find comment="netmanager-vpn" dst-address=10.99.128.0/24] action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn"
:if ([:len [/ip route find comment="netmanager-vpn" dst-address=10.99.0.0/24]] = 0) do={ /ip route add dst-address=10.99.0.0/24 gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn" }
/ip route set [find comment="netmanager-vpn" dst-address=10.99.0.0/24] gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn"
:if ([:len [/ip route find comment="netmanager-vpn" dst-address=10.99.128.0/24]] = 0) do={ /ip route add dst-address=10.99.128.0/24 gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn" }
/ip route set [find comment="netmanager-vpn" dst-address=10.99.128.0/24] gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn"
/system scheduler remove [find name=netmanager-vpn-switch]
/system script remove [find name=netmanager-vpn-switch]
/system script add name=netmanager-vpn-switch policy=read,write,test comment="netmanager-vpn" source=":global nmVpnFail\n:if ([:typeof \$nmVpnFail] != \"array\") do={ :set nmVpnFail [:toarray \"\"] }\n:local servers {\"hub-a.example.net|51821|xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg=\";\"203.0.113.20|51821|TrMvSoP4jYQlY6RIzBgbssQqY3vxI2Pi+y71lOWWXX0=\"}\n:if ([/ping 10.99.0.1 src-address=10.100.0.10 count=5 interval=1s] < 4) do={\n  :local cur [:tostr [/interface wireguard peers get [find interface=netmanager-vpn] endpoint-address]]\n  :set (\$nmVpnFail->\$cur) [:timestamp]\n  :local n [:len \$servers]\n  :local idx -1\n  :for i from=0 to=(\$n - 1) do={\n    :local s [:pick \$servers \$i]\n    :if ([:pick \$s 0 [:find \$s \"|\"]] = \$cur) do={ :set idx \$i }\n  }\n  :local next \"\"\n  :for k from=1 to=\$n do={\n    :local s [:pick \$servers ((\$idx + \$k) % \$n)]\n    :local h [:pick \$s 0 [:find \$s \"|\"]]\n    :local t (\$nmVpnFail->\$h)\n    :local fresh false\n    :if ([:typeof \$t] = \"time\") do={ :set fresh (([:timestamp] - \$t) < 00:05:00) }\n    :if ((\$next = \"\") && (\$fresh = false)) do={ :set next \$s }\n  }\n  :if (\$next = \"\") do={ :set next [:pick \$servers 0] }\n  :local p [:find \$next \"|\"]\n  :local host [:pick \$next 0 \$p]\n  :local rest [:pick \$next (\$p + 1) [:len \$next]]\n  :set p [:find \$rest \"|\"]\n  :if (\$host != \$cur) do={\n    /interface wireguard peers set [find interface=netmanager-vpn] endpoint-address=\$host endpoint-port=[:tonum [:pick \$rest 0 \$p]] public-key=[:pick \$rest (\$p + 1) [:len \$rest]]\n    :log warning (\"netmanager-vpn: pindah ke \" . \$host)\n  }\n}\n"
/system scheduler add name=netmanager-vpn-switch interval=20s policy=read,write,test comment="netmanager-vpn" on-event="/system script run netmanager-vpn-switch"
