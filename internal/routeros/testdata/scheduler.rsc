/system scheduler remove [find name=netmanager-vpn-switch]
/system script remove [find name=netmanager-vpn-switch]
/system script add name=netmanager-vpn-switch policy=read,write,test comment="netmanager-vpn" source=":global nmVpnFail\n:if ([:typeof \$nmVpnFail] != \"array\") do={ :set nmVpnFail [:toarray \"\"] }\n:local servers {\"hub-a.example.net|51821|xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg=\";\"203.0.113.20|51821|TrMvSoP4jYQlY6RIzBgbssQqY3vxI2Pi+y71lOWWXX0=\"}\n:if ([/ping 10.99.0.1 src-address=10.100.0.10 count=5 interval=1s] < 4) do={\n  :local cur [:tostr [/interface wireguard peers get [find interface=netmanager-vpn] endpoint-address]]\n  :set (\$nmVpnFail->\$cur) [:timestamp]\n  :local n [:len \$servers]\n  :local idx -1\n  :for i from=0 to=(\$n - 1) do={\n    :local s [:pick \$servers \$i]\n    :if ([:pick \$s 0 [:find \$s \"|\"]] = \$cur) do={ :set idx \$i }\n  }\n  :local next \"\"\n  :for k from=1 to=\$n do={\n    :local s [:pick \$servers ((\$idx + \$k) % \$n)]\n    :local h [:pick \$s 0 [:find \$s \"|\"]]\n    :local t (\$nmVpnFail->\$h)\n    :local fresh false\n    :if ([:typeof \$t] = \"time\") do={ :set fresh (([:timestamp] - \$t) < 00:05:00) }\n    :if ((\$next = \"\") && (\$fresh = false)) do={ :set next \$s }\n  }\n  :if (\$next = \"\") do={ :set next [:pick \$servers 0] }\n  :local p [:find \$next \"|\"]\n  :local host [:pick \$next 0 \$p]\n  :local rest [:pick \$next (\$p + 1) [:len \$next]]\n  :set p [:find \$rest \"|\"]\n  :if (\$host != \$cur) do={\n    /interface wireguard peers set [find interface=netmanager-vpn] endpoint-address=\$host endpoint-port=[:tonum [:pick \$rest 0 \$p]] public-key=[:pick \$rest (\$p + 1) [:len \$rest]]\n    :log warning (\"netmanager-vpn: pindah ke \" . \$host)\n  }\n}\n"
/system scheduler add name=netmanager-vpn-switch interval=20s policy=read,write,test comment="netmanager-vpn" on-event="/system script run netmanager-vpn-switch"
