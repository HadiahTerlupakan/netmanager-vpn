{
:local ver [/system resource get version]
:local cut false
:local num ""
:for k from=0 to=([:len $ver] - 1) do={ :local c [:pick $ver $k]; :if ([:typeof [:find "0123456789." $c]] != "num") do={ :set cut true }; :if ($cut = false) do={ :set num ($num . $c) } }
:local p [:find $num "."]
:local major [:tonum [:pick $num 0 $p]]
:set num [:pick $num ($p + 1) [:len $num]]
:set p [:find $num "."]
:local minor
:local patch 0
:if ([:typeof $p] = "num") do={ :set minor [:tonum [:pick $num 0 $p]]; :set patch [:tonum [:pick $num ($p + 1) [:len $num]]] } else={ :set minor [:tonum $num] }
:if ($major != 7 || $minor < 24 || ($minor = 24 && $patch < 5)) do={ :error "netmanager-vpn: butuh RouterOS minimal 7.24.5" }
:if ([:len [/interface wireguard find name=netmanager-vpn]] > 0) do={ /interface wireguard set [find name=netmanager-vpn] name=netmanager-vpn-old }
:if ([:len [/interface l2tp-client find name=netmanager-vpn]] = 0) do={ /interface l2tp-client add name=netmanager-vpn connect-to="hub-a.example.net" ipsec-secret="c2VjcmV0LW9uZS1zZWNyZXQtb25lLXNlY3JldC1vbmU" user="nmvpn-0a1b2c3d" password="Zm9vYmFyYmF6cXV4cXV1eHF1dXhxdXV4" use-ipsec=yes allow=mschap2 max-mtu=1380 max-mru=1380 add-default-route=no disabled=no comment="netmanager-vpn: Kantor \"Pusat\" \$1"; :global nmVpnSwitchAt; :set nmVpnSwitchAt [/system resource get uptime] }
/interface l2tp-client set [find name=netmanager-vpn] user="nmvpn-0a1b2c3d" password="Zm9vYmFyYmF6cXV4cXV1eHF1dXhxdXV4" use-ipsec=yes allow=mschap2 max-mtu=1380 max-mru=1380 add-default-route=no disabled=no comment="netmanager-vpn: Kantor \"Pusat\" \$1"
{ :local id ([/interface l2tp-client find name=netmanager-vpn]->0); :local cur ([:tostr [/interface l2tp-client get $id connect-to]] . "|500|" . [/interface l2tp-client get $id ipsec-secret]); :local list {"hub-a.example.net|500|c2VjcmV0LW9uZS1zZWNyZXQtb25lLXNlY3JldC1vbmU";"203.0.113.20|500|c2VjcmV0LXR3by1zZWNyZXQtdHdvLXNlY3JldC10d28"}; :if ([:typeof [:find $list $cur]] != "num") do={ /interface l2tp-client set $id connect-to="hub-a.example.net" ipsec-secret="c2VjcmV0LW9uZS1zZWNyZXQtb25lLXNlY3JldC1vbmU"; :global nmVpnSwitchAt; :set nmVpnSwitchAt [/system resource get uptime] } }
:if ([:len [/routing table find name=netmanager-vpn]] = 0) do={ /routing table add name=netmanager-vpn fib comment="netmanager-vpn" }
/routing table set [find name=netmanager-vpn] comment="netmanager-vpn"
:if ([:len [/routing rule find comment="netmanager-vpn" dst-address=10.99.0.0/24]] = 0) do={ :if ([:len [/routing rule find]] = 0) do={ /routing rule add dst-address=10.99.0.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" } else={ /routing rule add dst-address=10.99.0.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" place-before=([/routing rule find]->0) } }
/routing rule set [find comment="netmanager-vpn" dst-address=10.99.0.0/24] action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn"
:if ([:len [/routing rule find comment="netmanager-vpn" dst-address=10.99.128.0/24]] = 0) do={ :if ([:len [/routing rule find]] = 0) do={ /routing rule add dst-address=10.99.128.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" } else={ /routing rule add dst-address=10.99.128.0/24 action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn" place-before=([/routing rule find]->0) } }
/routing rule set [find comment="netmanager-vpn" dst-address=10.99.128.0/24] action=lookup-only-in-table table=netmanager-vpn comment="netmanager-vpn"
{ :local all [/routing rule find]; :local f; :local found false; :foreach i in=$all do={ :if (($found = false) && ([:tostr [/routing rule get $i comment]] != "netmanager-vpn")) do={ :set f $i; :set found true } }; :if ($found) do={ :local r ([/routing rule find comment="netmanager-vpn" dst-address=10.99.0.0/24]->0); :if ([:find $all $f] < [:find $all $r]) do={ /routing rule move $r destination=$f } } }
{ :local all [/routing rule find]; :local f; :local found false; :foreach i in=$all do={ :if (($found = false) && ([:tostr [/routing rule get $i comment]] != "netmanager-vpn")) do={ :set f $i; :set found true } }; :if ($found) do={ :local r ([/routing rule find comment="netmanager-vpn" dst-address=10.99.128.0/24]->0); :if ([:find $all $f] < [:find $all $r]) do={ /routing rule move $r destination=$f } } }
:if ([:len [/ip route find comment="netmanager-vpn" dst-address=10.99.0.0/24]] = 0) do={ /ip route add dst-address=10.99.0.0/24 gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn" }
/ip route set [find comment="netmanager-vpn" dst-address=10.99.0.0/24] gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn"
:if ([:len [/ip route find comment="netmanager-vpn" dst-address=10.99.128.0/24]] = 0) do={ /ip route add dst-address=10.99.128.0/24 gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn" }
/ip route set [find comment="netmanager-vpn" dst-address=10.99.128.0/24] gateway=netmanager-vpn routing-table=netmanager-vpn pref-src=10.100.0.10 comment="netmanager-vpn"
/system scheduler remove [find name=netmanager-vpn-switch]
/system script remove [find name=netmanager-vpn-switch]
/system script add name=netmanager-vpn-switch policy=read,write,policy,test comment="netmanager-vpn" source=":global nmVpnFail\n:global nmVpnFailCount\n:global nmVpnSwitchAt\n:if ([:typeof \$nmVpnFail] != \"array\") do={ :set nmVpnFail [:toarray \"\"] }\n:if ([:typeof \$nmVpnFailCount] != \"num\") do={ :set nmVpnFailCount 0 }\n:local servers {\"hub-a.example.net|500|c2VjcmV0LW9uZS1zZWNyZXQtb25lLXNlY3JldC1vbmU\";\"203.0.113.20|500|c2VjcmV0LXR3by1zZWNyZXQtdHdvLXNlY3JldC10d28\"}\n:local now [/system resource get uptime]\n:local settled true\n:if ([:typeof \$nmVpnSwitchAt] = \"time\") do={ :if ((\$now - \$nmVpnSwitchAt) < 00:01:00) do={ :set settled false } }\n:if (\$settled) do={\n  :local got 0\n  :do { :set got [/ping 10.99.0.1 src-address=10.100.0.10 count=5 interval=1s] } on-error={}\n  :if (\$got >= 4) do={ :set nmVpnFailCount 0 } else={ :set nmVpnFailCount (\$nmVpnFailCount + 1) }\n  :if (\$nmVpnFailCount >= 2) do={\n    :set nmVpnFailCount 0\n    :local id ([/interface l2tp-client find name=netmanager-vpn]->0)\n    :local cur ([:tostr [/interface l2tp-client get \$id connect-to]] . \"|500|\" . [/interface l2tp-client get \$id ipsec-secret])\n    :local curEp [:pick \$cur 0 [:find \$cur \"|\" [:find \$cur \"|\"]]]\n    :set (\$nmVpnFail->\$curEp) \$now\n    :local n [:len \$servers]\n    :local idx [:find \$servers \$cur]\n    :if ([:typeof \$idx] != \"num\") do={ :set idx -1 }\n    :local next \"\"\n    :for k from=1 to=\$n do={\n      :local s [:pick \$servers ((\$idx + \$k) % \$n)]\n      :local ep [:pick \$s 0 [:find \$s \"|\" [:find \$s \"|\"]]]\n      :local t (\$nmVpnFail->\$ep)\n      :local fresh false\n      :if ([:typeof \$t] = \"time\") do={ :set fresh ((\$now - \$t) < 00:05:00) }\n      :if ((\$next = \"\") && (\$fresh = false)) do={ :set next \$s }\n    }\n    :if (\$next = \"\") do={ :set next [:pick \$servers 0] }\n    :if (\$next != \$cur) do={\n      :local p [:find \$next \"|\"]\n      :local host [:pick \$next 0 \$p]\n      :local rest [:pick \$next (\$p + 1) [:len \$next]]\n      :set p [:find \$rest \"|\"]\n      /interface l2tp-client set \$id connect-to=\$host ipsec-secret=[:pick \$rest (\$p + 1) [:len \$rest]]\n      :set nmVpnSwitchAt \$now\n      :log warning (\"netmanager-vpn: pindah ke \" . \$host)\n    }\n  }\n}\n"
/system scheduler add name=netmanager-vpn-switch interval=20s policy=read,write,policy,test comment="netmanager-vpn" on-event="/system script run netmanager-vpn-switch"
:if ([:len [/interface wireguard find name=netmanager-vpn-old]] > 0) do={ /interface wireguard peers remove [find interface=netmanager-vpn-old]; /interface wireguard remove [find name=netmanager-vpn-old] }
:if ([:len [/interface bridge find name=netmanager-lo]] > 0) do={ /ip address remove [find interface=netmanager-lo comment="netmanager-vpn"]; /interface bridge remove [find name=netmanager-lo] }
}
